+function renderFHReveal(view: Record<string, unknown>): void {
+  const history = (view["history"] as FHNight[]) ?? [];
+  const peaks = (view["twoPeaks"] as FHTwoPeaks[]) ?? [];
+  $("gameBody").innerHTML = `
