+
+  const hx = R * 0.246;
+  const hy = R * 0.246 * (50 / 94) * SQUASH * 1.18;
+  const CP = (u: number, v: number): [number, number] => [n(fcx + u * hx * (1 + 0.05 * v)), n(fcy + v * hy)];
