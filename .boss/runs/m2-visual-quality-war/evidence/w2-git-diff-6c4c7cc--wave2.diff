+  defs.push(
+    '<radialGradient id="' + id("flood") + '" cx="50%" cy="50%" r="50%">' +
+      '<stop offset="0%" stop-color="#fff4dc" stop-opacity="' + n(0.62 * light * dim) + '"/>' +
+      '<stop offset="18%" stop-color="' + GOLD + '" stop-opacity="' + n(0.16 * light * dim) + '"/>' +
