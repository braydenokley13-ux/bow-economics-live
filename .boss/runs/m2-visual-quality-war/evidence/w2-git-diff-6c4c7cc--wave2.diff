+  );
+
+  defs.push(
+    '<radialGradient id="' + id("spill") + '" cx="50%" cy="50%" r="50%">' +
+      '<stop offset="0%" stop-color="#a78dff" stop-opacity="' + n(0.24 * light * dim) + '"/>' +
+      '<stop offset="42%" stop-color="' + VIOLET + '" stop-opacity="' + n(0.1 * light * dim) + '"/>' +
