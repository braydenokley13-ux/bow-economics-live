+      '<circle cx="' + n(bx) + '" cy="' + n(by) + '" r="' + n(br) + '" fill="' +
+      (rand() > 0.4 ? "#ffd9a0" : "#9fbdff") + '" fill-opacity="' + n((0.12 + rand() * 0.42) * dim) + '"/>';
+  }
+  out.push('<g filter="url(#' + id("soft") + ')">' + bokeh + "</g>");
