+    '<rect x="0" y="' + n(horizon - R * 0.05) + '" width="' + width + '" height="' + n(R * 0.42) +
+      '" fill="#191a2e" opacity="' + n(0.35 * dim) + '" filter="url(#' + id("soft") + ')"/>'
+  );
+
+  /* ground pool around the building */
+  out.push(
+    '<ellipse cx="' + n(cx) + '" cy="' + n(cy + R * RINGS.plaza.dy) + '" rx="' + n(R * RINGS.plaza.rx) +
