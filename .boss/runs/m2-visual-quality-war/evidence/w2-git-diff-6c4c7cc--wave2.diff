+  defs.push(
+    '<filter id="' + id("soft") + '" x="-30%" y="-30%" width="160%" height="160%">' +
+      '<feGaussianBlur stdDeviation="' + n(R * 0.014) + '"/></filter>'
+  );
+
+  /* --- 1. sky, city, ground ---------------------------------------- */
+  out.push('<rect width="' + width + '" height="' + height + '" fill="' + VOID + '"/>');
+
+  const horizon = cy - R * 0.5;
+  const skyN = detail === "high" ? 22 : 14;
