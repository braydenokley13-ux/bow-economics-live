+      '" height="' + n(bh + R * 0.5) + '"/>';
+  }
+  out.push('<g fill="#0b0b14" fill-opacity="' + n(0.9 * dim) + '">' + sky + "</g>");
+
+  const bokehN = detail === "high" ? 54 : 30;
