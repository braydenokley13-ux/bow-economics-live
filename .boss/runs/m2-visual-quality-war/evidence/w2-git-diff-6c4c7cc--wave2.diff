+    defs.push(
+      '<linearGradient id="' + id("maskgrad") + '" x1="0" y1="0" x2="1" y2="0">' +
+        '<stop offset="0%" stop-color="#000"/>' +
+        '<stop offset="30%" stop-color="#101010"/>' +
