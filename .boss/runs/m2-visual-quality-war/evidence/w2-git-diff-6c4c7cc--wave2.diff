+
+  const deckY = cy + R * (RINGS.roofOut.dy + WALL + 0.03);
+  out.push(
+    '<ellipse cx="' + n(cx) + '" cy="' + n(deckY) + '" rx="' + n(R * 1.34) + '" ry="' +
+      n(R * 1.34 * SQUASH * 0.72) + '" fill="#0c0c15" fill-opacity="' + n(0.55 * dim) + '"/>'
