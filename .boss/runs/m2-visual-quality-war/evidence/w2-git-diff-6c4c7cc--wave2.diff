+  /* Gate light scales with `light`: a closed building's doors are dark. */
+  defs.push(
+    '<radialGradient id="' + id("gate") + '" cx="50%" cy="50%" r="50%">' +
+      '<stop offset="0%" stop-color="#ffdca8" stop-opacity="' + n(0.3 * light * dim) + '"/>' +
