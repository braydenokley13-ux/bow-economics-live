+      renderFHPlay(view);
+      return;
+    case "REVEAL":
+      renderFHReveal(view);
+      return;
+    case "ADAPT":
+      renderFHAdapt(view);
+      return;
+    case "COUNTERFACTUAL":
+      renderFHCounterfactual(view);
+      return;
+    case "SYNTHESIS":
+      renderFHSynthesis(view);
+      return;
+    case "COMPLETE":
+      renderFHComplete(view);
+      return;
+    default:
+      body.innerHTML = `<pre class="banner" style="text-align:left; white-space:pre-wrap;">${escapeHtml(JSON.stringify(view, null, 2))}</pre>`;
+  }
 }
 
 
