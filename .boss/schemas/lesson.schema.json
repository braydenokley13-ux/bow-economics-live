{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bow.education/schemas/boss/lesson.schema.json",
  "title": "BOW Boss lesson",
  "type": "object",
  "required": ["id", "statement", "status", "scope", "confidence", "sourceRuns", "evidence", "counterexamples", "createdAt", "reviewAt"],
  "properties": {
    "id": { "type": "string" },
    "statement": { "type": "string", "minLength": 10 },
    "status": { "enum": ["observation", "provisional", "repeated-evidence", "candidate-precedent", "founder-approved-rule", "retired"] },
    "scope": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "sourceRuns": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "counterexamples": { "type": "array", "items": { "type": "string" } },
    "createdAt": { "type": "string", "format": "date-time" },
    "reviewAt": { "type": "string", "format": "date-time" },
    "founderApproval": { "type": ["object", "null"] }
  }
}
