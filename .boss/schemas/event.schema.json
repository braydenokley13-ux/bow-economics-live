{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bow.education/schemas/boss/event.schema.json",
  "title": "BOW Boss runtime event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sequence", "runId", "type", "timestamp", "actor", "data", "previousHash", "hash"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "runId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "type": { "type": "string", "minLength": 3 },
    "timestamp": { "type": "string", "format": "date-time" },
    "actor": { "type": "string", "minLength": 1 },
    "role": { "type": ["string", "null"] },
    "data": { "type": "object" },
    "previousHash": { "type": ["string", "null"] },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
